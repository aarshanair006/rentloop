# Copy this file to .env and fill in your own values. Never commit .env.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/rentloop
JWT_SECRET=replace-with-a-long-random-string
PORT=5000
# Optional. In production, the address of the frontend, e.g. https://rentloop.example.com
CLIENT_URL=
